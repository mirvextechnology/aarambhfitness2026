# ---------------------------------------------------------------
# Aarambh Fitness — environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file to version control.
# ---------------------------------------------------------------

# EmailJS (https://dashboard.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# WhatsApp number in international format, digits only (no + or spaces)
VITE_WHATSAPP_NUMBER=919999999999

# Google Maps embed URL (full https://www.google.com/maps/embed?... string)
VITE_GOOGLE_MAPS_URL=

# Public site origin, used for canonical + Open Graph URLs
VITE_SITE_URL=http://localhost:5173
